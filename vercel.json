{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "master": false
    }
  },
  "builds": [
    {
      "src": "serverless.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/assets/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "serverless.ts"
    }
  ]
}
